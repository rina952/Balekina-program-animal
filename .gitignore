# Виртуальное окружение (папка .venv, которую видно на вашем скриншоте)
.venv/
venv/
env/

# Кэш Python (создается автоматически при запуске)
__pycache__/
*.py[cod]
*$py.class

# Настройки вашей среды разработки (VS Code, PyCharm)
.vscode/
.idea/

# Системные файлы (мусор от Windows/Mac)
.DS_Store
Thumbs.db

# Файлы с секретами (пароли, токены - если будут в будущем)
.env